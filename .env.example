DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-secret-for-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Set when spirits2u.com is connected; used for canonical URLs and the sitemap.
# PUBLIC_SITE_URL=https://spirits2u.com
# CSRF_TRUSTED_ORIGINS=https://spirits2u.com,https://www.spirits2u.com

# Optional: set DATABASE_URL for PostgreSQL. Local development uses SQLite.
# DATABASE_URL=postgresql://user:password@localhost:5432/store_website
